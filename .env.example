# Project Mode either 'development' or 'production'
NODE_ENV="development"

# API Base Domains (can be changed for Dev, Staging, and Production)
NEXT_PUBLIC_TRADING_API_URL="https://trading-api.example.com"
NEXT_PUBLIC_USER_API_URL="https://user-api.example.com"
NEXT_PUBLIC_CMS_API_URL="https://cms-api.example.com"
NEXT_PUBLIC_SMART_DOCS_API_URL="https://smart-docs-api.example.com"

# Assets CDN Link
NEXT_PUBLIC_ASSETS_URL="https://assets.example.com"

# Cache lifetimes (in seconds) for Next.js 16 caching
CATEGORIES_CACHE_STALE="300"
CATEGORIES_CACHE_REVALIDATE="3600"
CATEGORIES_CACHE_EXPIRE="86400"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ReCAPTCHA v2 Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

#Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Google Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Apple Auth
NEXT_PUBLIC_APPLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_REDIRECT_URI=""

# Payment Gateways (Razorpay & PayPal)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""