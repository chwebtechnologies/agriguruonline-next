# API Base Domains (can be changed for Dev, Staging, and Production)
NEXT_PUBLIC_TRADING_API_URL=https://trading-api.example.com
NEXT_PUBLIC_USER_API_URL=https://user-api.example.com
NEXT_PUBLIC_CMS_API_URL=https://cms-api.example.com

# Assets CDN Link
NEXT_PUBLIC_ASSETS_URL=https://assets.example.com

# Cache lifetimes (in seconds) for Next.js 16 caching
CATEGORIES_CACHE_STALE=300
CATEGORIES_CACHE_REVALIDATE=3600
CATEGORIES_CACHE_EXPIRE=86400
NEXT_PUBLIC_SITE_URL=https://example.com

# ReCAPTCHA v2 Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"

#Firebase configuration settings
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key"

# Google Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-gooogle-auth-client-id"